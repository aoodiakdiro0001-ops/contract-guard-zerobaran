# ============================================================
# Contract-Guard ZeroBaran - متغيرات البيئة (نموذج)
# انسخ هذا الملف إلى .env واملأ القيم بمفاتيحك المجانية
# المؤلف: Baran Avisat
# ============================================================

# ===== محرك الذكاء الاصطناعي (اختر واحداً على الأقل) =====
# Google Gemini API - احصل عليه مجاناً من: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API - احصل عليه مجاناً من: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# المزود النشط: gemini أو groq
AI_PROVIDER=gemini

# ===== قاعدة بيانات Supabase =====
# احصل عليه مجاناً من: https://supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ===== بوت تليجرام =====
# أنشئ بوت عبر @BotFather واحصل على التوكن
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# معرّف الدردشة (Chat ID) - استخدم @userinfobot للحصول عليه
TELEGRAM_CHAT_ID=your_chat_id_here

# ===== إعدادات عامة =====
# مستوى صرامة التحليل: lenient | balanced | strict
ANALYSIS_STRICTNESS=balanced
# اللغة الافتراضية للتقارير: ar | en | mixed
REPORT_LANGUAGE=ar
# الحد الأقصى لعدد البنود في كل دفعة تحليل
MAX_CLAUSES_PER_BATCH=20
# تفعيل السجلات التفصيلية
DEBUG=true
